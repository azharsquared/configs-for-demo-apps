        }
      ]
    },
    {
      "id": "2",
      "step": "Kafan (Shrouding)",
      "description": "The body is wrapped in simple white cloth (kafan). Men: 3 pieces of cloth. Women: 5 pieces of cloth.",
      "details": [
        "Use simple, white, clean cloth",
        "No elaborate or expensive materials",
        "Tied at head and feet",
        "Should cover entire body"
      ],
      "rulings": "Fard Kifayah",
      "media": [
