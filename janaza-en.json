    {
      "id": "3",
      "step": "Salat al-Janazah (Funeral Prayer)",
      "description": "A specific prayer performed in congregation for the deceased. This is performed standing (no ruku or sujud).",
      "details": [
        "Takbir (Allahu Akbar) - 4 times",
        "First Takbir: Recite Al-Fatihah",
        "Second Takbir: Send blessings on Prophet (PBUH)",
        "Third Takbir: Make dua for the deceased",
        "Fourth Takbir: Make general dua and give salam"
      ],
      "rulings": "Fard Kifayah",
      "media": [
