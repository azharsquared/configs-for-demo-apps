  "JANAZAH_PROCEDURE": [
    {
      "id": "1",
      "step": "Ghusl (Washing)",
      "description": "The body must be washed by people of the same gender (ideally family members or designated washers). This is a mandatory act of respect.",
      "details": [
        "Performed in a private, clean space",
        "Body is washed an odd number of times (3, 5, or 7)",
        "Started with wudu-like washing",
        "Use clean water and soap/sidr leaves"
      ],
      "rulings": "Fard Kifayah (communal obligation)",
      "media": [
        {
          "type": "video",
          "title": "Sample Video Guide",
          "url": "https://www.youtube.com/watch?v=mDvqVqgK7Cs",
